# Copy this file to .env and fill in your personal access token (PAT).
# Create a PAT in the NOMAD GUI: Profile > Settings > Tokens > CREATE NEW TOKEN
# Recommended scopes: "READ ONLY" shortcut (covers entries, uploads, raw downloads).
NOMAD_API_URL="https://nomad-sadewasser.inl.local/nomad-oasis/api/v1"
NOMAD_PAT="paste-your-token-here"
# Set to "1" only if the Oasis serves a certificate signed by a trusted CA.
NOMAD_VERIFY_SSL="0"
